# Application Configuration
NODE_ENV=development
API_PORT=18500
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Database Configuration
DATABASE_URL=postgresql://autoag:autoag_secret@localhost:18510/autoag
POSTGRES_HOST=localhost
POSTGRES_PORT=18510
POSTGRES_DB=autoag
POSTGRES_USER=autoag
POSTGRES_PASSWORD=autoag_secret

# Redis Configuration
REDIS_URL=redis://localhost:18520
REDIS_HOST=localhost
REDIS_PORT=18520
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=change-this-secret-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-refresh-secret-too
JWT_REFRESH_EXPIRES_IN=7d

# x402 Payment Configuration (Phase 5)
X402_ENABLED=false
X402_WALLET_ADDRESS=
X402_PRIVATE_KEY=
X402_NETWORK=testnet

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_PREMIUM_MAX=10000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:18500
CORS_CREDENTIALS=true

# Monitoring Configuration (Phase 6)
PROMETHEUS_PORT=18540
GRAFANA_PORT=18541
LOKI_PORT=18550
JAEGER_UI_PORT=18560
JAEGER_COLLECTOR_PORT=18561
JAEGER_AGENT_PORT=18562

# Development Tools
SWAGGER_PORT=18570
DB_ADMIN_PORT=18580
REDIS_UI_PORT=18581
MAILHOG_SMTP_PORT=18590
MAILHOG_UI_PORT=18591

# MCP Server Configuration
MCP_HEALTH_CHECK_INTERVAL_MS=300000
MCP_TIMEOUT_MS=30000

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_DEFAULT_TTL=3600
