// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER MANAGEMENT
// ============================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  username      String    @unique
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false) @map("email_verified")
  apiKey        String?   @unique @map("api_key")
  
  // x402 Wallet Integration (Phase 5)
  walletAddress String?   @unique @map("wallet_address")
  walletBalance Decimal   @default(0) @map("wallet_balance") @db.Decimal(20, 8)
  
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")
  
  // Relations
  mcpServers    MCPServer[]
  transactions  Transaction[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  
  @@map("users")
  @@index([email])
  @@index([username])
  @@index([apiKey])
}

enum UserRole {
  USER
  DEVELOPER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

// ============================================================================
// API KEY MANAGEMENT
// ============================================================================

model ApiKey {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  key         String   @unique
  name        String
  scopes      String[] // Array of permission scopes
  rateLimit   Int      @default(100) @map("rate_limit")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("api_keys")
  @@index([userId])
  @@index([key])
}

// ============================================================================
// MCP SERVER REGISTRY
// ============================================================================

model MCPServer {
  id                String        @id @default(uuid())
  ownerId           String        @map("owner_id")
  name              String
  displayName       String        @map("display_name")
  description       String?       @db.Text
  baseUrl           String        @map("base_url")
  version           String        @default("1.0.0")
  status            ServerStatus  @default(PENDING)
  visibility        Visibility    @default(PRIVATE)
  
  // Pricing & Monetization
  pricingModel      PricingModel  @default(FREE) @map("pricing_model")
  pricePerCall      Decimal?      @map("price_per_call") @db.Decimal(20, 8)
  subscriptionPrice Decimal?      @map("subscription_price") @db.Decimal(20, 8)
  commissionRate    Decimal       @default(0.15) @map("commission_rate") @db.Decimal(5, 4) // Platform commission (15%)
  
  // Metadata
  category          String[]      // Array of categories
  tags              String[]      // Array of tags
  logoUrl           String?       @map("logo_url")
  documentationUrl  String?       @map("documentation_url")
  repositoryUrl     String?       @map("repository_url")
  licenseType       String?       @map("license_type")
  
  // Health & Performance
  lastHealthCheck   DateTime?     @map("last_health_check")
  healthStatus      HealthStatus  @default(UNKNOWN) @map("health_status")
  avgResponseTime   Int?          @map("avg_response_time") // milliseconds
  uptime            Decimal?      @db.Decimal(5, 2) // percentage
  
  // Statistics
  totalCalls        BigInt        @default(0) @map("total_calls")
  totalRevenue      Decimal       @default(0) @map("total_revenue") @db.Decimal(20, 8)
  totalUsers        Int           @default(0) @map("total_users")
  rating            Decimal?      @db.Decimal(3, 2) // 0.00 to 5.00
  reviewCount       Int           @default(0) @map("review_count")
  
  // Timestamps
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  publishedAt       DateTime?     @map("published_at")
  
  // Relations
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tools             Tool[]
  transactions      Transaction[]
  reviews           Review[]
  analytics         Analytics[]
  
  @@unique([ownerId, name])
  @@map("mcp_servers")
  @@index([status])
  @@index([visibility])
  @@index([category])
  @@index([ownerId])
}

enum ServerStatus {
  PENDING       // Awaiting approval
  ACTIVE        // Live and discoverable
  INACTIVE      // Temporarily disabled
  DEPRECATED    // No longer maintained
  REJECTED      // Failed approval
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum PricingModel {
  FREE
  PAY_PER_CALL
  SUBSCRIPTION
  FREEMIUM
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

// ============================================================================
// TOOL REGISTRY
// ============================================================================

model Tool {
  id              String      @id @default(uuid())
  serverId        String      @map("server_id")
  name            String
  displayName     String      @map("display_name")
  description     String?     @db.Text
  
  // Tool Configuration
  inputSchema     Json        @map("input_schema") // JSON Schema
  outputSchema    Json?       @map("output_schema")
  examples        Json?       // Array of example calls
  
  // Pricing (can override server-level pricing)
  pricePerCall    Decimal?    @map("price_per_call") @db.Decimal(20, 8)
  
  // Statistics
  totalCalls      BigInt      @default(0) @map("total_calls")
  totalRevenue    Decimal     @default(0) @map("total_revenue") @db.Decimal(20, 8)
  avgResponseTime Int?        @map("avg_response_time")
  successRate     Decimal?    @map("success_rate") @db.Decimal(5, 2)
  
  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  // Relations
  server          MCPServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  invocations     Invocation[]
  
  @@unique([serverId, name])
  @@map("tools")
  @@index([serverId])
  @@index([name])
}

// ============================================================================
// INVOCATION TRACKING
// ============================================================================

model Invocation {
  id              String          @id @default(uuid())
  toolId          String          @map("tool_id")
  userId          String?         @map("user_id") // Null for anonymous
  
  // Request/Response
  inputData       Json            @map("input_data")
  outputData      Json?           @map("output_data")
  status          InvocationStatus
  errorMessage    String?         @map("error_message") @db.Text
  
  // Performance Metrics
  startTime       DateTime        @map("start_time")
  endTime         DateTime?       @map("end_time")
  durationMs      Int?            @map("duration_ms")
  
  // Billing
  cost            Decimal?        @db.Decimal(20, 8)
  transactionId   String?         @unique @map("transaction_id")
  
  // Timestamps
  createdAt       DateTime        @default(now()) @map("created_at")
  
  // Relations
  tool            Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)
  transaction     Transaction?    @relation(fields: [transactionId], references: [id])
  
  @@map("invocations")
  @@index([toolId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

enum InvocationStatus {
  SUCCESS
  FAILURE
  TIMEOUT
  RATE_LIMITED
  UNAUTHORIZED
}

// ============================================================================
// PAYMENT & TRANSACTIONS (x402 Integration)
// ============================================================================

model Transaction {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  serverId        String?           @map("server_id")
  
  // Transaction Details
  type            TransactionType
  amount          Decimal           @db.Decimal(20, 8)
  currency        String            @default("USD")
  status          TransactionStatus
  
  // x402 Payment Details
  x402TxHash      String?           @unique @map("x402_tx_hash")
  x402Network     String?           @map("x402_network")
  x402BlockHeight BigInt?           @map("x402_block_height")
  
  // Platform Commission
  platformFee     Decimal           @map("platform_fee") @db.Decimal(20, 8)
  netAmount       Decimal           @map("net_amount") @db.Decimal(20, 8)
  
  // Metadata
  description     String?
  metadata        Json?
  
  // Timestamps
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  completedAt     DateTime?         @map("completed_at")
  
  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  server          MCPServer?        @relation(fields: [serverId], references: [id])
  invocation      Invocation?
  
  @@map("transactions")
  @@index([userId])
  @@index([serverId])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  PAYMENT         // User pays for tool invocation
  PAYOUT          // Developer receives payment
  DEPOSIT         // User deposits funds
  WITHDRAWAL      // User withdraws funds
  REFUND          // Refund to user
  COMMISSION      // Platform commission
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

// ============================================================================
// REVIEWS & RATINGS
// ============================================================================

model Review {
  id          String    @id @default(uuid())
  serverId    String    @map("server_id")
  userId      String    @map("user_id")
  rating      Int       // 1-5 stars
  title       String?
  comment     String?   @db.Text
  isVerified  Boolean   @default(false) @map("is_verified") // Verified purchase
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  server      MCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  
  @@unique([serverId, userId])
  @@map("reviews")
  @@index([serverId])
  @@index([rating])
}

// ============================================================================
// ANALYTICS & METRICS
// ============================================================================

model Analytics {
  id              String    @id @default(uuid())
  serverId        String    @map("server_id")
  date            DateTime  @db.Date
  
  // Metrics
  totalCalls      Int       @default(0) @map("total_calls")
  successfulCalls Int       @default(0) @map("successful_calls")
  failedCalls     Int       @default(0) @map("failed_calls")
  uniqueUsers     Int       @default(0) @map("unique_users")
  totalRevenue    Decimal   @default(0) @map("total_revenue") @db.Decimal(20, 8)
  avgResponseTime Int?      @map("avg_response_time")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  
  server          MCPServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  
  @@unique([serverId, date])
  @@map("analytics")
  @@index([serverId])
  @@index([date])
}

// ============================================================================
// AUDIT LOGGING
// ============================================================================

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?   @map("user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  changes     Json?     // Before/after values
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
